{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "docs/api-reference/**",
    "docs/changelog/**",
    "public/schema/**",
    "schema/**",
    "public/saleor-search-metadata.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
