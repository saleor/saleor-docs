{
  "name": "saleor-docs-blume",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm prepare:search && ASTRO_TELEMETRY_DISABLED=1 blume dev --host 127.0.0.1",
    "build": "pnpm prepare:search && ASTRO_TELEMETRY_DISABLED=1 blume build && node scripts/postbuild.mjs",
    "build:isolated": "pnpm prepare:search && ASTRO_TELEMETRY_DISABLED=1 BLUME_SERVER=0 blume build --isolated && BLUME_SERVER=0 BLUME_RUNTIME_DIR=.blume-verify node scripts/postbuild.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 blume preview --host 127.0.0.1 --port 4321",
    "blume:doctor": "blume doctor",
    "typecheck": "pnpm prepare:search && blume check --strict",
    "typecheck:isolated": "pnpm prepare:search && blume check --isolated --strict",
    "validate": "pnpm prepare:search && node scripts/validate-source.mjs",
    "validate:external": "pnpm prepare:search && blume validate --external",
    "audit": "blume audit --skip BLUME_AUDIT_ANCHOR_BROKEN",
    "audit:external": "blume audit --external --fail-on error --skip BLUME_AUDIT_ANCHOR_BROKEN",
    "audit:live": "blume audit --fail-on error --skip BLUME_AUDIT_ANCHOR_BROKEN",
    "analyze": "pnpm prepare:search && ASTRO_TELEMETRY_DISABLED=1 blume build --analyze --isolated",
    "eval:docs": "blume eval",
    "update-release-notes": "node scripts/update-release-notes.mjs",
    "test": "node --test tests/*.test.mjs",
    "generate-api-reference": "node scripts/generate-api.mjs",
    "update-schema": "node scripts/update-schema.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:isolated": "BLUME_SERVER=0 BLUME_OUTPUT_DIR=.blume-verify/dist pnpm check:artifacts && BLUME_BUILD_DIR=.blume-verify/dist pnpm check:search",
    "prepare:search": "node scripts/prepare-skills.mjs && node scripts/prepare-search.mjs",
    "knip": "knip --config knip.config.ts"
  },
  "dependencies": {
    "@sentry/browser": "9.29.0",
    "astro": "7.3.4",
    "blume": "2.0.3",
    "flexsearch": "0.8.212",
    "graphql": "16.9.0",
    "gray-matter": "4.0.3",
    "js-yaml": "4.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "shiki": "4.4.3"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "11.8.0",
    "@vercel/routing-utils": "6.6.0",
    "cheerio": "1.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "knip": "5.46.2"
  }
}
