---
import { repositoryUrl } from '../scripts/repository-config.mjs';
const api = Astro.url.pathname.startsWith("/api-reference");
const feedbackUrl = `${repositoryUrl()}/issues`;
---
<footer
  class="mx-auto mt-12 max-w-content pt-6 text-sm"
  data-saleor-subfooter
  data-generated-reference={api || undefined}
>
  <nav aria-label="Page resources" class="flex flex-wrap items-center gap-x-6 gap-y-2">
    <a href="https://saleor.io/discord" rel="noreferrer" target="_blank">Help</a>
    <a href={feedbackUrl} rel="noreferrer" target="_blank">Feedback</a>
  </nav>
</footer>

<style>
  :global([data-generated-reference] + p) { display: none; }
  /*
   * Blume renders the last-modified line and feedback widget immediately after
   * this slot. Treat the three siblings as a single compact page sub-footer
   * while retaining Blume's metadata and feedback event handling.
   */
  :global([data-saleor-subfooter] + p) {
    margin-top: -1.25rem;
    padding-left: 18rem;
    text-align: right;
  }

  :global([data-saleor-subfooter] + p + [data-blume-page-feedback]) {
    margin-top: 1.5rem;
    border-top: 0;
    padding-top: 0;
  }

  @media (max-width: 639px) {
    :global([data-saleor-subfooter] + p) {
      margin-top: 0.75rem;
      padding-left: 0;
      text-align: left;
    }

    :global([data-saleor-subfooter] + p + [data-blume-page-feedback]) {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
