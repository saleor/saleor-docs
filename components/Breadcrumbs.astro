---
import { withMountedBase } from 'blume/components/islands/base-path.ts';
import provenance from '../schema/provenance.json';
const route = Astro.url.pathname.replace(/\/$/, '') || '/';
const api = route.startsWith('/api-reference');
---
{api && <div class="mx-auto max-w-content mb-4 text-sm text-muted-foreground">
  <p class="flex flex-wrap gap-x-4 gap-y-2">
    <span class="font-medium text-foreground">Schema: {provenance.label}</span>
    <a class="underline" href={withMountedBase('/schema/saleor.graphql')}>Download SDL</a>
    <a class="underline" href={withMountedBase('/upgrade-guides')}>Upgrade guides</a>
  </p>
</div>}
