---
const route = Astro.url.pathname.replace(/\/$/, '');
const paths: Record<string, {href: string; label: string}> = {
  '/quickstart/cloud': {href: '/quickstart/api', label: 'Build your first checkout'},
  '/quickstart/running-locally': {href: '/quickstart/api', label: 'Make your first API request'},
  '/quickstart/api': {href: '/quickstart/storefront', label: 'Connect a storefront'},
  '/quickstart/storefront': {href: '/developer/checkout/api-guide', label: 'Explore the checkout API guide'},
};
const next = paths[route];
---
{next && <nav aria-label="Continue learning" class="mx-auto mt-10 max-w-content border-t border-border pt-6">
  <a href={next.href} class="block rounded-blume border border-border p-5 hover:border-foreground">
    <span class="block text-sm text-muted-foreground">Next step</span>
    <span class="font-semibold">{next.label} →</span>
  </a>
</nav>}
