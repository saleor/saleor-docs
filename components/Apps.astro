---
import { apps, appUrl } from './app-list';
import Card from 'blume/components/content/Card.astro';
import CardGroup from 'blume/components/content/CardGroup.astro';
---
<div class="app-cards">
  <CardGroup cols={2}>
    {apps.map(([name, route, icon]) => (
      <Card title={name} href={appUrl(route)} icon={'/img/apps/' + icon + '.svg'} arrow />
    ))}
  </CardGroup>
</div>

<style>
  .app-cards :global(img[src*="/img/apps/"]) {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: contain;
    object-position: left center;
  }
  .app-cards :global(img[src$="/adyen.svg"]) {
    width: 48px;
    height: 24px;
    object-fit: cover;
  }
</style>
