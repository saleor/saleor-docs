---
import { isAssetIcon } from "blume/theme/icon-kind.ts";
import { hasIcon } from "blume/theme/icons.ts";
import { stepAnchor } from "./step-headings.mjs";
import Icon from "blume/components/Icon.astro";

interface Props {
  icon?: string;
  title?: string;
}

const { icon, title } = Astro.props;
const markerClass =
  "absolute top-0.5 -start-[2.75rem] flex size-6 items-center justify-center rounded-full bg-accent text-center font-semibold text-accent-foreground text-xs";
const canRenderIcon =
  icon !== undefined && (isAssetIcon(icon) || hasIcon(icon));
---

<div class="saleor-step relative [counter-increment:blume-step]">
  <span aria-hidden="true" class:list={[markerClass, !canRenderIcon && "before:[content:counter(blume-step)]"]}>
    {canRenderIcon && <Icon name={icon} size={14} />}
  </span>
  {
    title && (
      <h2 id={stepAnchor(title)} class="mb-1.5 font-semibold text-[length:var(--blume-step-title-size,1rem)] leading-[var(--blume-step-title-line-height,1.75rem)]">
        {title}
      </h2>
    )
  }
  <div class="[&>:first-child]:mt-0! [&>:last-child]:mb-0!">
    <slot />
  </div>
</div>
