---
import Badge from "blume/components/content/Badge.astro";
import Icon from "blume/components/Icon.astro";

interface Props {
  label: string;
  values: string;
}

const { label, values } = Astro.props;
const permissions = values.split(",").filter(Boolean);
---

<div class="saleor-permissions" aria-label={`${label}: ${permissions.join(", ")}`}>
  <Icon name="lock-keyhole" size={18} />
  <span class="saleor-permissions-label">{label}:</span>
  {permissions.map((permission) => <Badge color="surface" size="md">{permission}</Badge>)}
</div>

<style>
  .saleor-permissions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin-block: 1.5rem;
    line-height: 1.5;
  }

  .saleor-permissions-label {
    margin-right: 0.1rem;
  }
</style>
