---
import type { ComponentProps } from 'astro/types';
import RootLayout from 'blume/components/layout/RootLayout.astro';
import { sidebarForTabs, tabsForRoute } from './navigation-sections.mjs';
type Props = ComponentProps<typeof RootLayout>;
const props = Astro.props;
const tabs = tabsForRoute(props.page.route);
const navigation = {
  ...props.navigation,
  tabs,
  sidebar: sidebarForTabs(props.navigation.sidebar, tabs),
};
---
<RootLayout {...props} navigation={navigation}><slot /></RootLayout>

<script>
  import { installPageActionMenus } from './page-action-menus';
  installPageActionMenus();
  import { installDiagramZoom } from './diagram-zoom';
  installDiagramZoom();
</script>

<style is:global>
  /* Match the 6px icon gap used by expandable sidebar groups. */
  .blume-nav-link > .flex { gap: 0.375rem; }

  /* Keep the four section labels intact; tablet navigation uses the drawer. */
  [data-blume-header] nav[aria-label="Sections"] a { white-space: nowrap; }
  @media (max-width: 1023px) {
    [data-blume-header] nav[aria-label="Sections"] { display: none; }
    #blume-nav-drawer nav[aria-label="Sections"] { display: block; }
  }
</style>

<style is:global>
  blume-mermaid { display: block; }
  .diagram-expand, .diagram-toolbar button {
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.375rem 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .diagram-expand { margin-block: 0.5rem; }
  .diagram-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: 96vw;
    max-width: none;
    height: 92dvh;
    max-height: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .diagram-dialog[open] { display: flex; flex-direction: column; }
  .diagram-dialog::backdrop { background: rgb(0 0 0 / 65%); }
  .diagram-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; padding: 0.75rem; border-bottom: 1px solid var(--color-border); }
  .diagram-toolbar output { min-width: 3rem; text-align: center; }
  .diagram-viewport { flex: 1; min-height: 0; overflow: auto; padding: 1rem; overscroll-behavior: contain; }
</style>
