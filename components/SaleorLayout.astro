---
import type { ComponentProps } from 'astro/types';
import RootLayout from 'blume/components/layout/RootLayout.astro';
import { sidebarForTabs, tabsForRoute } from './navigation-sections.mjs';
type Props = ComponentProps<typeof RootLayout>;
const props = Astro.props;
const tabs = tabsForRoute(props.page.route);
const navigation = {
  ...props.navigation,
  tabs,
  sidebar: sidebarForTabs(props.navigation.sidebar, tabs),
};
---
<RootLayout {...props} navigation={navigation}><slot /></RootLayout>

<script>
  import { installPageActionMenus } from './page-action-menus';
  installPageActionMenus();
  import { installDiagramZoom } from './diagram-zoom';
  installDiagramZoom();
</script>

<style is:global>
  /* Match the 6px icon gap used by expandable sidebar groups. */
  .blume-nav-link > .flex { gap: 0.375rem; }

  /* Keep the four section labels intact; tablet navigation uses the drawer. */
  [data-blume-header] nav[aria-label="Sections"] a { white-space: nowrap; }
  @media (max-width: 1023px) {
    [data-blume-header] nav[aria-label="Sections"] { display: none; }
    #blume-nav-drawer nav[aria-label="Sections"] { display: block; }
  }
</style>

<style is:global>
  blume-mermaid { display: block; }
  .diagram-expand, .diagram-toolbar button {
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.375rem 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .diagram-expand { margin-block: 0.5rem; }
  .diagram-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: 96vw;
    max-width: none;
    height: 92dvh;
    max-height: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .diagram-dialog[open] { display: flex; flex-direction: column; }
  .diagram-dialog::backdrop { background: rgb(0 0 0 / 65%); }
  .diagram-toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; padding: 0.75rem; border-bottom: 1px solid var(--color-border); }
  .diagram-toolbar button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border-color: transparent;
  }
  .diagram-toolbar button:hover { background: var(--color-muted); }
  .diagram-toolbar .diagram-close { margin-inline-start: auto; }
  .diagram-toolbar output { min-width: 3.5rem; text-align: center; font-variant-numeric: tabular-nums; color: var(--color-muted-foreground); }
  .diagram-viewport { flex: 1; min-height: 0; overflow: auto; padding: 1rem; overscroll-behavior: contain; }
</style>

<style is:global>
  /* Search previews use compact typography independent of full-page prose. */
  [data-blume-search-preview] .search-page-preview {
    max-width: 100%;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  [data-blume-search-preview] .search-page-preview :is(h1, h2, h3, h4, h5, h6) {
    margin-block: 1rem 0.5rem;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: normal;
  }
  [data-blume-search-preview] .search-page-preview :is(p, ul, ol, blockquote, pre, table) {
    margin-block: 0.625rem;
  }
  [data-blume-search-preview] .search-page-preview li { margin-block: 0.25rem; }
  [data-blume-search-preview] .search-page-preview :is(pre, table) {
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.8125rem;
  }
  [data-blume-search-preview] .search-page-preview > :first-child { margin-top: 0; }
</style>

<style is:global>
  /* Give narrow screens more room for content: reduce outer spacing by a third. */
  @media (max-width: 639px) {
    #blume-content {
      padding-inline: 1rem;
      padding-top: 1rem;
      padding-bottom: 1.625rem;
    }
  }
</style>
