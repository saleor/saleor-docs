# Site URLs are derived from Vercel system environment variables.
# Enable access to System Environment Variables in the Vercel project.

# Configure these in Vercel; leave telemetry unset for local checks.
GTM_CONTAINER_ID=
SENTRY_DSN=

# Optional build-time source-map uploads. Never expose the token to the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
